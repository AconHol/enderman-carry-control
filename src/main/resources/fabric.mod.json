    "issues": "https://github.com/AconHol/enderman-carry-control/issues"
  },
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "main": ["io.github.aconhol.endermancarry.EndermanCarryControl"]
  },
  "mixins": ["enderman-carry-control.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.2",
    "java": ">=25",
    "fabric-api": ">=0.161.0"
  }
